{
  "name": "incident-hub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "dotenv -e ../.env.example --no-override -- prisma generate",
    "prisma:validate": "dotenv -e ../.env.example --no-override -- prisma validate"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "body-parser": "2.4.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "11.0.0",
    "prisma": "6.12.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.25.12": true,
    "prisma@6.12.0": true
  }
}
